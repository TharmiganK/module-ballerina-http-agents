{
  "type": "object",
  "additionalProperties": false,
  "required": ["pattern", "units", "exclude"],
  "properties": {
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "root_cause"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 500},
        "root_cause": {"type": "string", "minLength": 1, "maxLength": 3000},
        "fix": {"type": "string", "maxLength": 3000}
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "spec_sections", "paths", "test_packages", "hints"],
        "properties": {
          "id": {"type": "string", "minLength": 3, "maxLength": 40},
          "description": {"type": "string", "minLength": 1, "maxLength": 300},
          "spec_sections": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 20}},
          "paths": {"type": "array", "minItems": 1, "maxItems": 25, "items": {"type": "string", "maxLength": 300}},
          "test_packages": {"type": "array", "maxItems": 4, "items": {"type": "string", "maxLength": 60}},
          "hints": {"type": "array", "maxItems": 15, "items": {"type": "string", "maxLength": 300}}
        }
      }
    },
    "exclude": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 300}}
  }
}
