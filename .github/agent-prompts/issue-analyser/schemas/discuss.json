{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "comment"
  ],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "plan-ready",
        "needs-info",
        "analysed",
        "close-suggested",
        "no-change"
      ]
    },
    "comment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60000
    },
    "new_plan_version": {
      "type": "integer",
      "minimum": 1
    },
    "test_package": {
      "type": "string",
      "maxLength": 100
    },
    "test_filter": {
      "type": "string",
      "maxLength": 200
    },
    "close_reason": {
      "type": "string",
      "enum": [
        "duplicate",
        "not-a-bug",
        "cannot-reproduce",
        "out-of-scope",
        "invalid"
      ]
    },
    "duplicate_of": {
      "type": "string",
      "pattern": "^([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)?#[0-9]+$",
      "maxLength": 200
    },
    "simple": {
      "type": "boolean"
    },
    "simple_reason": {
      "type": "string",
      "maxLength": 300
    }
  }
}
