{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "classification",
    "outcome",
    "comment"
  ],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "plan-ready",
        "needs-info",
        "analysed",
        "close-suggested",
        "split"
      ]
    },
    "comment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60000
    },
    "test_package": {
      "type": "string",
      "maxLength": 100
    },
    "test_filter": {
      "type": "string",
      "maxLength": 200
    },
    "classification": {
      "type": "string",
      "enum": [
        "bug",
        "improvement",
        "feature",
        "question",
        "mixed"
      ]
    },
    "parts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "classification",
          "title",
          "body"
        ],
        "properties": {
          "classification": {
            "type": "string",
            "enum": [
              "bug",
              "improvement",
              "feature"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 10,
            "maxLength": 120
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        }
      }
    },
    "close_reason": {
      "type": "string",
      "enum": [
        "duplicate",
        "not-a-bug",
        "cannot-reproduce",
        "out-of-scope",
        "invalid"
      ]
    },
    "duplicate_of": {
      "type": "string",
      "pattern": "^([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)?#[0-9]+$",
      "maxLength": 200
    },
    "simple": {
      "type": "boolean"
    },
    "simple_reason": {
      "type": "string",
      "maxLength": 300
    }
  }
}
